make_json_table_path_spec : Node.Text, Node.Text, I64, I64 -> Node
make_json_table_path_spec = |string_arg, name_arg, string_location_arg, name_location_arg| {
	var $string = string_arg
	var $name = name_arg
	var $string_location = string_location_arg
	var $name_location = name_location_arg
	var $pathspec = Node.JsonTablePathSpec(Node.json_table_path_spec_default)
	$pathspec = Node.JsonTablePathSpec({ ..Node.json_table_path_spec_of($pathspec), string: make_string_const($string, $string_location) })
	if !(!Rt.text_is_set($name)) {
		$pathspec = Node.JsonTablePathSpec({ ..Node.json_table_path_spec_of($pathspec), name: $name })
	}
	$pathspec = Node.JsonTablePathSpec({ ..Node.json_table_path_spec_of($pathspec), name_location: $name_location })
	$pathspec = Node.JsonTablePathSpec({ ..Node.json_table_path_spec_of($pathspec), location: $string_location })
	$pathspec
}

