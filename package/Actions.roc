	var $n = Node.FunctionParameter(Node.function_parameter_default)
	$n = Node.FunctionParameter({ ..Node.function_parameter_of($n), name: Err(Null) })
	$n = Node.FunctionParameter({ ..Node.function_parameter_of($n), arg_type: $a1 })
	$n = Node.FunctionParameter({ ..Node.function_parameter_of($n), mode: 100 })
	$n = Node.FunctionParameter({ ..Node.function_parameter_of($n), defexpr: Node.Null })
	$n = Node.FunctionParameter({ ..Node.function_parameter_of($n), location: l1 })
	$result = $n
	Ok(Rt.of_node($result))
}

