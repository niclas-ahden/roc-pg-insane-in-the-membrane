	var $result = Rt.node_at(v, 0)
	var $t = make_type_name_from_name_list($a1)
	$t = Node.TypeName({ ..Node.type_name_of($t), location: l1 })
	$result = make_string_const_cast($a2, l2, $t)
	Ok(Rt.of_node($result))
