## ConstraintAttributeSpec: ConstraintAttributeSpec ConstraintAttributeElem
rule_826 : Rt.Ctx, List(Rt.Value), List(I64), I64 -> Try(Rt.Value, Scan.Problem)
rule_826 = |ctx, v, l, _loc| {
	var $a1 = Rt.int_at(v, 0)
	var $a2 = Rt.int_at(v, 1)
	l2 = Rt.location(l, 1)
	var $result = Rt.int_at(v, 0)
	var $newspec = Rt.bit_or($a1, $a2)
	if (Rt.bit_and($newspec, Rt.bit_or(1, 8)) == Rt.bit_or(1, 8)) {
		return Err(Rt.error(ctx, "42601", Ok("constraint declared INITIALLY DEFERRED must be DEFERRABLE"), l2))
	}
	if (((Rt.bit_and($newspec, Rt.bit_or(1, 2)) == Rt.bit_or(1, 2)) or (Rt.bit_and($newspec, Rt.bit_or(4, 8)) == Rt.bit_or(4, 8))) or (Rt.bit_and($newspec, Rt.bit_or(64, 128)) == Rt.bit_or(64, 128))) {
		return Err(Rt.error(ctx, "42601", Ok("conflicting constraint properties"), l2))
	}
	$result = $newspec
	Ok(Rt.of_int($result))
}

