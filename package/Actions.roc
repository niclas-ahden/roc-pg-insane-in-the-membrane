## limit_clause: LIMIT select_limit_value
rule_1778 : Rt.Ctx, List(Rt.Value), List(I64), I64 -> Try(Rt.Value, Scan.Problem)
rule_1778 = |_ctx, v, l, _loc| {
	var $a2 = Rt.node_at(v, 1)
	l1 = Rt.location(l, 0)
	var $result = Rt.node_at(v, 0)
	var $n = Node.SelectLimit(Node.select_limit_default)
	$n = Node.SelectLimit({ ..Node.select_limit_of($n), limit_offset: Node.Null })
	$n = Node.SelectLimit({ ..Node.select_limit_of($n), limit_count: $a2 })
	$n = Node.SelectLimit({ ..Node.select_limit_of($n), limit_option: 0 })
	$n = Node.SelectLimit({ ..Node.select_limit_of($n), offset_loc: (0 - 1) })
	$n = Node.SelectLimit({ ..Node.select_limit_of($n), count_loc: l1 })
	$n = Node.SelectLimit({ ..Node.select_limit_of($n), option_loc: (0 - 1) })
	$result = $n
	Ok(Rt.of_node($result))
}

