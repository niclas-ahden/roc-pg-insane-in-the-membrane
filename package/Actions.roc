	$n = Node.UpdateStmt({ ..Node.update_stmt_of($n), relation: $a3 })
	$n = Node.UpdateStmt({ ..Node.update_stmt_of($n), target_list: $a5 })
	$n = Node.UpdateStmt({ ..Node.update_stmt_of($n), from_clause: $a6 })
	$n = Node.UpdateStmt({ ..Node.update_stmt_of($n), where_clause: $a7 })
	$n = Node.UpdateStmt({ ..Node.update_stmt_of($n), returning_clause: $a8 })
	$n = Node.UpdateStmt({ ..Node.update_stmt_of($n), with_clause: $a1 })
	$result = $n
	Ok(Rt.of_node($result))
}

