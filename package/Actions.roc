	$t = Node.TypeName({ ..Node.type_name_of($t), typmods: Rt.list_make2(make_int_const(32767, (0 - 1)), make_int_const($a3, l3)) })
	$a1 = $t
	$result = make_string_const_cast($a5, l5, $t)
	Ok(Rt.of_node($result))
}

