	var $a1 = Rt.int_at(v, 0)
	var $a2 = Rt.list_at(v, 1)
	var $a3 = Rt.int_at(v, 2)
	var $result = Rt.node_at(v, 0)
	var $n = Node.LockingClause(Node.locking_clause_default)
	$n = Node.LockingClause({ ..Node.locking_clause_of($n), locked_rels: $a2 })
	$n = Node.LockingClause({ ..Node.locking_clause_of($n), strength: $a1 })
	$n = Node.LockingClause({ ..Node.locking_clause_of($n), wait_policy: $a3 })
	$result = $n
	Ok(Rt.of_node($result))
}

