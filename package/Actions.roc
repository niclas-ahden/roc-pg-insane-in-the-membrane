## VacuumStmt: VACUUM opt_full opt_freeze opt_verbose opt_analyze opt_vacuum_relation_list
rule_1556 : Rt.Ctx, List(Rt.Value), List(I64), I64 -> Try(Rt.Value, Scan.Problem)
rule_1556 = |_ctx, v, l, _loc| {
	var $a2 = Rt.bool_at(v, 1)
	var $a3 = Rt.bool_at(v, 2)
	var $a4 = Rt.bool_at(v, 3)
	var $a5 = Rt.bool_at(v, 4)
	var $a6 = Rt.list_at(v, 5)
	l2 = Rt.location(l, 1)
	l3 = Rt.location(l, 2)
	l4 = Rt.location(l, 3)
	l5 = Rt.location(l, 4)
	var $result = Rt.node_at(v, 0)
	var $n = Node.VacuumStmt(Node.vacuum_stmt_default)
	$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), options: [] })
	if $a2 {
		$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), options: Rt.lappend(Node.vacuum_stmt_of($n).options, make_def_elem(Ok("full"), Node.Null, l2)) })
	}
	if $a3 {
		$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), options: Rt.lappend(Node.vacuum_stmt_of($n).options, make_def_elem(Ok("freeze"), Node.Null, l3)) })
	}
	if $a4 {
		$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), options: Rt.lappend(Node.vacuum_stmt_of($n).options, make_def_elem(Ok("verbose"), Node.Null, l4)) })
	}
	if $a5 {
		$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), options: Rt.lappend(Node.vacuum_stmt_of($n).options, make_def_elem(Ok("analyze"), Node.Null, l5)) })
	}
	$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), rels: $a6 })
	$n = Node.VacuumStmt({ ..Node.vacuum_stmt_of($n), is_vacuumcmd: Bool.True })
	$result = $n
	Ok(Rt.of_node($result))
}

