	var $a1 = Rt.node_at(v, 0)
	l1 = Rt.location(l, 0)
	var $result = Rt.node_at(v, 0)
	if !((((Node.function_parameter_of($a1).mode == 100) or (Node.function_parameter_of($a1).mode == 105)) or (Node.function_parameter_of($a1).mode == 118))) {
