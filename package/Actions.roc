## a_expr: a_expr IS NULL_P
rule_2057 : Rt.Ctx, List(Rt.Value), List(I64), I64 -> Try(Rt.Value, Scan.Problem)
rule_2057 = |_ctx, v, l, _loc| {
	var $a1 = Rt.node_at(v, 0)
	l2 = Rt.location(l, 1)
	var $result = Rt.node_at(v, 0)
	var $n = Node.NullTest(Node.null_test_default)
	$n = Node.NullTest({ ..Node.null_test_of($n), arg: $a1 })
	$n = Node.NullTest({ ..Node.null_test_of($n), nulltesttype: 0 })
	$n = Node.NullTest({ ..Node.null_test_of($n), location: l2 })
	$result = $n
	Ok(Rt.of_node($result))
}

