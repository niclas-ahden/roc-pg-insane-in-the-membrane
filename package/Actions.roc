	l2 = Rt.location(l, 1)
	var $result = Node.Null
	var $n = $a2
	$n = Node.PLAssignStmt({ ..Node.pl_assign_stmt_of($n), nnames: 1 })
	$a2 = $n
	$result = Rt.list_node(Rt.list_make1(make_raw_stmt($n, l2)))
	Ok(Rt.of_node($result))
}

