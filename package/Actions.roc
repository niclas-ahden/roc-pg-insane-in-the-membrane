## func_arg_expr: param_name COLON_EQUALS a_expr
rule_2295 : Rt.Ctx, List(Rt.Value), List(I64), I64 -> Try(Rt.Value, Scan.Problem)
rule_2295 = |_ctx, v, l, _loc| {
	var $a1 = Rt.text_at(v, 0)
	var $a3 = Rt.node_at(v, 2)
	l1 = Rt.location(l, 0)
	var $result = Rt.node_at(v, 0)
	var $na = Node.NamedArgExpr(Node.named_arg_expr_default)
	$na = Node.NamedArgExpr({ ..Node.named_arg_expr_of($na), name: $a1 })
	$na = Node.NamedArgExpr({ ..Node.named_arg_expr_of($na), arg: $a3 })
	$na = Node.NamedArgExpr({ ..Node.named_arg_expr_of($na), argnumber: (0 - 1) })
	$na = Node.NamedArgExpr({ ..Node.named_arg_expr_of($na), location: l1 })
	$result = $na
	Ok(Rt.of_node($result))
}

