	} else {
		if (Rt.strcmp($a2, Ok("restrictive")) == 0) {
			$result = Bool.False
		} else {
			return Err(Rt.error(ctx, "42601", Ok("unrecognized row security option \"${Rt.text_str($a2)}\""), l2))
		}
	}
	Ok(Rt.of_bool($result))
}

