expr_location : Node -> I64
expr_location = |expr_arg| {
	var $expr = expr_arg
	var $loc = 0.I64
	if Node.is_null($expr) {
		return (0 - 1)
	}
	match Node.tag($expr) {
		"RangeVar" => {
			$loc = Node.range_var_of($expr).location
		}
		"GroupingFunc" => {
			$loc = Node.grouping_func_of($expr).location
		}
		"MergeSupportFunc" => {
			$loc = Node.merge_support_func_of($expr).location
		}
		"NamedArgExpr" => {
			var $na = $expr
			$loc = leftmost_loc(Node.named_arg_expr_of($na).location, expr_location(Node.named_arg_expr_of($na).arg))
		}
		"BoolExpr" => {
			var $bexpr = $expr
			$loc = leftmost_loc(Node.bool_expr_of($bexpr).location, expr_location(Rt.list_node(Node.bool_expr_of($bexpr).args)))
		}
		"SubLink" => {
			var $sublink = $expr
			$loc = leftmost_loc(expr_location(Node.sub_link_of($sublink).testexpr), Node.sub_link_of($sublink).location)
		}
		"CaseExpr" => {
			$loc = Node.case_expr_of($expr).location
		}
		"CaseWhen" => {
			$loc = Node.case_when_of($expr).location
		}
		"RowExpr" => {
			$loc = Node.row_expr_of($expr).location
		}
		"CoalesceExpr" => {
			$loc = Node.coalesce_expr_of($expr).location
		}
		"MinMaxExpr" => {
			$loc = Node.min_max_expr_of($expr).location
		}
		"SQLValueFunction" => {
			$loc = Node.sql_value_function_of($expr).location
		}
		"XmlExpr" => {
			var $xexpr = $expr
			$loc = leftmost_loc(Node.xml_expr_of($xexpr).location, expr_location(Rt.list_node(Node.xml_expr_of($xexpr).args)))
		}
		"JsonFormat" => {
			$loc = Node.json_format_of($expr).location
		}
		"JsonValueExpr" => {
			$loc = expr_location(Node.json_value_expr_of($expr).raw_expr)
		}
		"JsonIsPredicate" => {
			$loc = Node.json_is_predicate_of($expr).location
		}
		"JsonBehavior" => {
			$loc = expr_location(Node.json_behavior_of($expr).expr)
		}
		"NullTest" => {
			var $nexpr = $expr
			$loc = leftmost_loc(Node.null_test_of($nexpr).location, expr_location(Node.null_test_of($nexpr).arg))
		}
		"BooleanTest" => {
			var $bexpr_2 = $expr
			$loc = leftmost_loc(Node.boolean_test_of($bexpr_2).location, expr_location(Node.boolean_test_of($bexpr_2).arg))
		}
		"SetToDefault" => {
			$loc = Node.set_to_default_of($expr).location
		}
		"IntoClause" => {
			$loc = expr_location(Node.into_clause_of($expr).rel)
		}
		"List" => {
			$loc = (0 - 1)
			var $lc_list = Rt.node_list($expr)
			var $lc_index = 0
			while $lc_index < $lc_list.len() {
				$loc = expr_location(($lc_list.get($lc_index) ?? Node.Null))
				if ($loc >= 0) {
					break
				}
				$lc_index = $lc_index + 1
			}
		}
		"A_Expr" => {
			var $aexpr = $expr
			$loc = leftmost_loc(Node.a_expr_of($aexpr).location, expr_location(Node.a_expr_of($aexpr).lexpr))
		}
		"ColumnRef" => {
			$loc = Node.column_ref_of($expr).location
		}
		"ParamRef" => {
			$loc = Node.param_ref_of($expr).location
		}
		"A_Const" => {
			$loc = Node.a_const_of($expr).location
		}
		"FuncCall" => {
			var $fc = $expr
			$loc = leftmost_loc(Node.func_call_of($fc).location, expr_location(Rt.list_node(Node.func_call_of($fc).args)))
		}
		"A_ArrayExpr" => {
			$loc = Node.a_array_expr_of($expr).location
		}
		"ResTarget" => {
			$loc = Node.res_target_of($expr).location
		}
		"MultiAssignRef" => {
			$loc = expr_location(Node.multi_assign_ref_of($expr).source)
		}
		"TypeCast" => {
			var $tc = $expr
			$loc = expr_location(Node.type_cast_of($tc).arg)
			$loc = leftmost_loc($loc, Node.type_name_of(Node.type_cast_of($tc).type_name).location)
			$loc = leftmost_loc($loc, Node.type_cast_of($tc).location)
		}
		"CollateClause" => {
			$loc = expr_location(Node.collate_clause_of($expr).arg)
		}
		"SortBy" => {
			$loc = expr_location(Node.sort_by_of($expr).node)
		}
		"WindowDef" => {
			$loc = Node.window_def_of($expr).location
		}
		"RangeTableSample" => {
			$loc = Node.range_table_sample_of($expr).location
		}
		"TypeName" => {
			$loc = Node.type_name_of($expr).location
		}
		"ColumnDef" => {
			$loc = Node.column_def_of($expr).location
		}
		"Constraint" => {
			$loc = Node.constraint_of($expr).location
		}
		"FunctionParameter" => {
			$loc = Node.function_parameter_of($expr).location
		}
		"XmlSerialize" => {
			$loc = Node.xml_serialize_of($expr).location
		}
		"GroupingSet" => {
			$loc = Node.grouping_set_of($expr).location
		}
		"WithClause" => {
			$loc = Node.with_clause_of($expr).location
		}
		"InferClause" => {
			$loc = Node.infer_clause_of($expr).location
		}
		"OnConflictClause" => {
			$loc = Node.on_conflict_clause_of($expr).location
		}
		"CTESearchClause" => {
			$loc = Node.cte_search_clause_of($expr).location
		}
		"CTECycleClause" => {
			$loc = Node.cte_cycle_clause_of($expr).location
		}
		"CommonTableExpr" => {
			$loc = Node.common_table_expr_of($expr).location
		}
		"JsonKeyValue" => {
			$loc = expr_location(Node.json_key_value_of($expr).key)
		}
		"JsonObjectConstructor" => {
			$loc = Node.json_object_constructor_of($expr).location
		}
		"JsonArrayConstructor" => {
			$loc = Node.json_array_constructor_of($expr).location
		}
		"JsonArrayQueryConstructor" => {
			$loc = Node.json_array_query_constructor_of($expr).location
		}
		"JsonAggConstructor" => {
			$loc = Node.json_agg_constructor_of($expr).location
		}
		"JsonObjectAgg" => {
			$loc = expr_location(Node.json_object_agg_of($expr).constructor)
		}
		"JsonArrayAgg" => {
			$loc = expr_location(Node.json_array_agg_of($expr).constructor)
		}
		"PartitionElem" => {
			$loc = Node.partition_elem_of($expr).location
		}
		"PartitionSpec" => {
			$loc = Node.partition_spec_of($expr).location
		}
		"PartitionBoundSpec" => {
			$loc = Node.partition_bound_spec_of($expr).location
		}
		_ => {
			$loc = (0 - 1)
		}
	}
	$loc
}

make_simple_a_expr : I64, Node.Text, Node, Node, I64 -> Node
make_simple_a_expr = |kind_arg, name_arg, lexpr_arg, rexpr_arg, location_arg| {
	var $kind = kind_arg
	var $name = name_arg
	var $lexpr = lexpr_arg
	var $rexpr = rexpr_arg
	var $location = location_arg
	var $a = Node.AExpr(Node.a_expr_default)
	$a = Node.AExpr({ ..Node.a_expr_of($a), kind: $kind })
	$a = Node.AExpr({ ..Node.a_expr_of($a), name: Rt.list_make1(make_string($name)) })
	$a = Node.AExpr({ ..Node.a_expr_of($a), lexpr: $lexpr })
	$a = Node.AExpr({ ..Node.a_expr_of($a), rexpr: $rexpr })
	$a = Node.AExpr({ ..Node.a_expr_of($a), location: $location })
	$a
}

make_range_var : Node.Text, Node.Text, I64 -> Node
make_range_var = |schemaname_arg, relname_arg, location_arg| {
	var $schemaname = schemaname_arg
	var $relname = relname_arg
	var $location = location_arg
	var $r = Node.RangeVar(Node.range_var_default)
	$r = Node.RangeVar({ ..Node.range_var_of($r), catalogname: Err(Null) })
	$r = Node.RangeVar({ ..Node.range_var_of($r), schemaname: $schemaname })
	$r = Node.RangeVar({ ..Node.range_var_of($r), relname: $relname })
	$r = Node.RangeVar({ ..Node.range_var_of($r), inh: Bool.True })
	$r = Node.RangeVar({ ..Node.range_var_of($r), relpersistence: 112 })
	$r = Node.RangeVar({ ..Node.range_var_of($r), alias: Node.Null })
	$r = Node.RangeVar({ ..Node.range_var_of($r), location: $location })
	$r
}

make_type_cast : Node, Node, I64 -> Node
make_type_cast = |arg_arg, typename_arg, location_arg| {
	var $arg = arg_arg
	var $typename = typename_arg
	var $location = location_arg
	var $n = Node.TypeCast(Node.type_cast_default)
	$n = Node.TypeCast({ ..Node.type_cast_of($n), arg: $arg })
	$n = Node.TypeCast({ ..Node.type_cast_of($n), type_name: $typename })
	$n = Node.TypeCast({ ..Node.type_cast_of($n), location: $location })
	$n
}

make_raw_stmt : Node, I64 -> Node
make_raw_stmt = |stmt_arg, stmt_location_arg| {
	var $stmt = stmt_arg
	var $stmt_location = stmt_location_arg
	var $rs = Node.RawStmt(Node.raw_stmt_default)
	$rs = Node.RawStmt({ ..Node.raw_stmt_of($rs), stmt: $stmt })
	$rs = Node.RawStmt({ ..Node.raw_stmt_of($rs), stmt_location: $stmt_location })
	$rs = Node.RawStmt({ ..Node.raw_stmt_of($rs), stmt_len: 0 })
	$rs
}

make_def_elem : Node.Text, Node, I64 -> Node
make_def_elem = |name_arg, arg_arg, location_arg| {
	var $name = name_arg
	var $arg = arg_arg
	var $location = location_arg
	var $res = Node.DefElem(Node.def_elem_default)
	$res = Node.DefElem({ ..Node.def_elem_of($res), defnamespace: Err(Null) })
	$res = Node.DefElem({ ..Node.def_elem_of($res), defname: $name })
	$res = Node.DefElem({ ..Node.def_elem_of($res), arg: $arg })
	$res = Node.DefElem({ ..Node.def_elem_of($res), defaction: 0 })
	$res = Node.DefElem({ ..Node.def_elem_of($res), location: $location })
	$res
}

make_string : Node.Text -> Node
make_string = |str_arg| {
	var $str = str_arg
	var $v = Node.String(Node.string_default)
	$v = Node.String({ ..Node.string_of($v), sval: $str })
	$v
}

make_boolean : Bool -> Node
make_boolean = |val_arg| {
	var $val = val_arg
	var $v = Node.Boolean(Node.boolean_default)
	$v = Node.Boolean({ ..Node.boolean_of($v), boolval: $val })
	$v
}

make_integer : I64 -> Node
make_integer = |i_arg| {
	var $i = i_arg
	var $v = Node.Integer(Node.integer_default)
	$v = Node.Integer({ ..Node.integer_of($v), ival: $i })
	$v
}

make_string_const_cast : Node.Text, I64, Node -> Node
make_string_const_cast = |str_arg, location_arg, typename_arg| {
	var $str = str_arg
	var $location = location_arg
	var $typename = typename_arg
	var $s = make_string_const($str, $location)
	make_type_cast($s, $typename, (0 - 1))
}

make_type_name_from_name_list : List(Node) -> Node
make_type_name_from_name_list = |names_arg| {
	var $names = names_arg
	var $n = Node.TypeName(Node.type_name_default)
	$n = Node.TypeName({ ..Node.type_name_of($n), names: $names })
	$n = Node.TypeName({ ..Node.type_name_of($n), typmods: [] })
	$n = Node.TypeName({ ..Node.type_name_of($n), typemod: (0 - 1) })
	$n = Node.TypeName({ ..Node.type_name_of($n), location: (0 - 1) })
	$n
}

make_def_elem_extended : Node.Text, Node.Text, Node, I64, I64 -> Node
make_def_elem_extended = |name_space_arg, name_arg, arg_arg, defaction_arg, location_arg| {
	var $name_space = name_space_arg
	var $name = name_arg
	var $arg = arg_arg
	var $defaction = defaction_arg
	var $location = location_arg
	var $res = Node.DefElem(Node.def_elem_default)
	$res = Node.DefElem({ ..Node.def_elem_of($res), defnamespace: $name_space })
	$res = Node.DefElem({ ..Node.def_elem_of($res), defname: $name })
	$res = Node.DefElem({ ..Node.def_elem_of($res), arg: $arg })
	$res = Node.DefElem({ ..Node.def_elem_of($res), defaction: $defaction })
	$res = Node.DefElem({ ..Node.def_elem_of($res), location: $location })
	$res
}

def_get_int32 : Node, Rt.Ctx -> Try(I64, Scan.Problem)
def_get_int32 = |def_arg, ctx| {
	var $def = def_arg
	if Node.is_null(Node.def_elem_of($def).arg) {
		return Err(Rt.error(ctx, "42601", Ok("${Rt.text_str(Node.def_elem_of($def).defname)} requires an integer value"), (0 - 1)))
	}
	match Node.tag(Node.def_elem_of($def).arg) {
		"Integer" => {
			return Ok(Node.integer_of(Node.def_elem_of($def).arg).ival)
		}
		_ => {
			return Err(Rt.error(ctx, "42601", Ok("${Rt.text_str(Node.def_elem_of($def).defname)} requires an integer value"), (0 - 1)))
		}
	}
	Ok(0)
}

make_range_var_from_any_name : List(Node), I64, Rt.Ctx -> Try(Node, Scan.Problem)
make_range_var_from_any_name = |names_arg, position_arg, ctx| {
	var $names = names_arg
	var $position = position_arg
	var $r = Node.RangeVar(Node.range_var_default)
	match Rt.list_length($names) {
		1 => {
			$r = Node.RangeVar({ ..Node.range_var_of($r), catalogname: Err(Null) })
			$r = Node.RangeVar({ ..Node.range_var_of($r), schemaname: Err(Null) })
			$r = Node.RangeVar({ ..Node.range_var_of($r), relname: Node.string_of(Rt.linitial($names)).sval })
		}
		2 => {
			$r = Node.RangeVar({ ..Node.range_var_of($r), catalogname: Err(Null) })
			$r = Node.RangeVar({ ..Node.range_var_of($r), schemaname: Node.string_of(Rt.linitial($names)).sval })
			$r = Node.RangeVar({ ..Node.range_var_of($r), relname: Node.string_of(Rt.lsecond($names)).sval })
		}
		3 => {
			$r = Node.RangeVar({ ..Node.range_var_of($r), catalogname: Node.string_of(Rt.linitial($names)).sval })
			$r = Node.RangeVar({ ..Node.range_var_of($r), schemaname: Node.string_of(Rt.lsecond($names)).sval })
			$r = Node.RangeVar({ ..Node.range_var_of($r), relname: Node.string_of(Rt.lthird($names)).sval })
		}
		_ => {
			return Err(Rt.error(ctx, "42601", Ok("improper qualified name (too many dotted names): ${Rt.text_str(name_list_to_string($names))}"), $position))
		}
	}
	$r = Node.RangeVar({ ..Node.range_var_of($r), relpersistence: 112 })
	$r = Node.RangeVar({ ..Node.range_var_of($r), location: $position })
	Ok($r)
}

parse_partition_strategy : Node.Text, I64, Rt.Ctx -> Try(I64, Scan.Problem)
parse_partition_strategy = |strategy_arg, location_arg, ctx| {
	var $strategy = strategy_arg
	var $location = location_arg
	if (Rt.pg_strcasecmp($strategy, Ok("list")) == 0) {
		return Ok(108)
	} else {
		if (Rt.pg_strcasecmp($strategy, Ok("range")) == 0) {
			return Ok(114)
		} else {
			if (Rt.pg_strcasecmp($strategy, Ok("hash")) == 0) {
				return Ok(104)
			}
		}
	}
	return Err(Rt.error(ctx, "22023", Ok("unrecognized partitioning strategy \"${Rt.text_str($strategy)}\""), $location))
	Ok(108)
}

make_float : Node.Text -> Node
make_float = |numeric_str_arg| {
	var $numeric_str = numeric_str_arg
	var $v = Node.Float(Node.float_default)
	$v = Node.Float({ ..Node.float_of($v), fval: $numeric_str })
	$v
}

make_role_spec : I64, I64 -> Node
make_role_spec = |type_arg, location_arg| {
	var $type = type_arg
	var $location = location_arg
	var $spec = Node.RoleSpec(Node.role_spec_default)
	$spec = Node.RoleSpec({ ..Node.role_spec_of($spec), roletype: $type })
	$spec = Node.RoleSpec({ ..Node.role_spec_of($spec), location: $location })
	$spec
}

merge_table_func_parameters : List(Node), List(Node), Rt.Ctx -> Try(List(Node), Scan.Problem)
merge_table_func_parameters = |func_args_arg, columns_arg, ctx| {
	var $func_args = func_args_arg
	var $columns = columns_arg
	var $lc_list = $func_args
	var $lc_index = 0
	while $lc_index < $lc_list.len() {
		var $p = ($lc_list.get($lc_index) ?? Node.Null)
		if ((!((Node.function_parameter_of($p).mode == 100)) and !((Node.function_parameter_of($p).mode == 105))) and !((Node.function_parameter_of($p).mode == 118))) {
			return Err(Rt.error(ctx, "42601", Ok("OUT and INOUT arguments aren't allowed in TABLE functions"), Node.function_parameter_of($p).location))
		}
		$lc_index = $lc_index + 1
	}
	Ok(Rt.list_concat($func_args, $columns))
}

table_func_type_name : List(Node) -> Node
table_func_type_name = |columns_arg| {
	var $columns = columns_arg
	var $result = Node.Null
	if (Rt.list_length($columns) == 1) {
		var $p = Rt.linitial($columns)
		$result = Node.function_parameter_of($p).arg_type
	} else {
		$result = system_type_name(Ok("record"))
	}
	$result = Node.TypeName({ ..Node.type_name_of($result), setof: Bool.True })
	$result
}

extract_arg_types : List(Node) -> List(Node)
extract_arg_types = |parameters_arg| {
	var $parameters = parameters_arg
	var $result = []
	var $i_list = $parameters
	var $i_index = 0
	while $i_index < $i_list.len() {
		var $p = ($i_list.get($i_index) ?? Node.Null)
		if (!((Node.function_parameter_of($p).mode == 111)) and !((Node.function_parameter_of($p).mode == 116))) {
			$result = Rt.lappend($result, Node.function_parameter_of($p).arg_type)
		}
		$i_index = $i_index + 1
	}
	$result
}

check_func_name : List(Node), Rt.Ctx -> Try(List(Node), Scan.Problem)
check_func_name = |names_arg, ctx| {
	var $names = names_arg
	var $i_list = $names
	var $i_index = 0
	while $i_index < $i_list.len() {
		if !((Node.tag(($i_list.get($i_index) ?? Node.Null)) == "String")) {
			return Err(Rt.yyerror(ctx, Ok("syntax error")))
		}
		$i_index = $i_index + 1
	}
	Ok($names)
}

make_ordered_set_args : List(Node), List(Node), Rt.Ctx -> Try(List(Node), Scan.Problem)
make_ordered_set_args = |directargs_arg, orderedargs_arg, ctx| {
	var $directargs = directargs_arg
	var $orderedargs = orderedargs_arg
	var $lastd = Rt.llast($directargs)
	var $ndirectargs = Node.Null
	if (Node.function_parameter_of($lastd).mode == 118) {
		var $firsto = Rt.linitial($orderedargs)
		if ((!((Rt.list_length($orderedargs) == 1)) or !((Node.function_parameter_of($firsto).mode == 118))) or !(Rt.equal(Node.function_parameter_of($lastd).arg_type, Node.function_parameter_of($firsto).arg_type))) {
			return Err(Rt.error(ctx, "0A000", Ok("an ordered-set aggregate with a VARIADIC direct argument must have one VARIADIC aggregated argument of the same data type"), Node.function_parameter_of($firsto).location))
		}
		$orderedargs = []
	}
	$ndirectargs = make_integer(Rt.list_length($directargs))
	Ok(Rt.list_make2(Rt.list_node(Rt.list_concat($directargs, $orderedargs)), $ndirectargs))
}

extract_aggr_arg_types : List(Node) -> List(Node)
extract_aggr_arg_types = |aggrargs_arg| {
	var $aggrargs = aggrargs_arg
	extract_arg_types(Rt.node_list(Rt.linitial($aggrargs)))
}

make_range_var_from_qualified_name : Node.Text, List(Node), I64, Rt.Ctx -> Try(Node, Scan.Problem)
make_range_var_from_qualified_name = |name_arg, namelist_arg, location_arg, ctx| {
	var $name = name_arg
	var $namelist = namelist_arg
	var $location = location_arg
	var $r = Node.Null
	_ = check_qualified_name($namelist, ctx)?
	$r = make_range_var(Err(Null), Err(Null), $location)
	match Rt.list_length($namelist) {
		1 => {
			$r = Node.RangeVar({ ..Node.range_var_of($r), catalogname: Err(Null) })
			$r = Node.RangeVar({ ..Node.range_var_of($r), schemaname: $name })
			$r = Node.RangeVar({ ..Node.range_var_of($r), relname: Node.string_of(Rt.linitial($namelist)).sval })
		}
		2 => {
			$r = Node.RangeVar({ ..Node.range_var_of($r), catalogname: $name })
			$r = Node.RangeVar({ ..Node.range_var_of($r), schemaname: Node.string_of(Rt.linitial($namelist)).sval })
			$r = Node.RangeVar({ ..Node.range_var_of($r), relname: Node.string_of(Rt.lsecond($namelist)).sval })
		}
		_ => {
			return Err(Rt.error(ctx, "42601", Ok("improper qualified name (too many dotted names): ${Rt.text_str(name_list_to_string(Rt.lcons(make_string($name), $namelist)))}"), $location))
		}
	}
	Ok($r)
}

make_recursive_view_select : Node.Text, List(Node), Node, Rt.Ctx -> Try(Node, Scan.Problem)
make_recursive_view_select = |relname_arg, aliases_arg, query_arg, ctx| {
	var $relname = relname_arg
	var $aliases = aliases_arg
	var $query = query_arg
	var $s = Node.SelectStmt(Node.select_stmt_default)
	var $w = Node.WithClause(Node.with_clause_default)
	var $cte = Node.CommonTableExpr(Node.common_table_expr_default)
	var $tl = []
	$cte = Node.CommonTableExpr({ ..Node.common_table_expr_of($cte), ctename: $relname })
	$cte = Node.CommonTableExpr({ ..Node.common_table_expr_of($cte), aliascolnames: $aliases })
	$cte = Node.CommonTableExpr({ ..Node.common_table_expr_of($cte), ctematerialized: 0 })
	$cte = Node.CommonTableExpr({ ..Node.common_table_expr_of($cte), ctequery: $query })
	$cte = Node.CommonTableExpr({ ..Node.common_table_expr_of($cte), location: (0 - 1) })
	$w = Node.WithClause({ ..Node.with_clause_of($w), recursive: Bool.True })
	$w = Node.WithClause({ ..Node.with_clause_of($w), ctes: Rt.list_make1($cte) })
	$w = Node.WithClause({ ..Node.with_clause_of($w), location: (0 - 1) })
	var $lc_list = $aliases
	var $lc_index = 0
	while $lc_index < $lc_list.len() {
		var $rt = Node.ResTarget(Node.res_target_default)
		$rt = Node.ResTarget({ ..Node.res_target_of($rt), name: Err(Null) })
		$rt = Node.ResTarget({ ..Node.res_target_of($rt), indirection: [] })
		$rt = Node.ResTarget({ ..Node.res_target_of($rt), val: make_column_ref(Node.string_of(($lc_list.get($lc_index) ?? Node.Null)).sval, [], (0 - 1), ctx)? })
		$rt = Node.ResTarget({ ..Node.res_target_of($rt), location: (0 - 1) })
		$tl = Rt.lappend($tl, $rt)
		$lc_index = $lc_index + 1
	}
	$s = Node.SelectStmt({ ..Node.select_stmt_of($s), with_clause: $w })
	$s = Node.SelectStmt({ ..Node.select_stmt_of($s), target_list: $tl })
	$s = Node.SelectStmt({ ..Node.select_stmt_of($s), from_clause: Rt.list_make1(make_range_var(Err(Null), $relname, (0 - 1))) })
	Ok($s)
}

