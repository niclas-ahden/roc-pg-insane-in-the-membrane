	make_type_name_from_name_list(Rt.list_make2(make_string(Ok("pg_catalog")), make_string($name)))
}

make_func_call : List(Node), List(Node), I64, I64 -> Node
make_func_call = |name_arg, args_arg, funcformat_arg, location_arg| {
	var $name = name_arg
	var $args = args_arg
	var $funcformat = funcformat_arg
	var $location = location_arg
	var $n = Node.FuncCall(Node.func_call_default)
	$n = Node.FuncCall({ ..Node.func_call_of($n), funcname: $name })
	$n = Node.FuncCall({ ..Node.func_call_of($n), args: $args })
	$n = Node.FuncCall({ ..Node.func_call_of($n), agg_order: [] })
	$n = Node.FuncCall({ ..Node.func_call_of($n), agg_filter: Node.Null })
	$n = Node.FuncCall({ ..Node.func_call_of($n), over: Node.Null })
	$n = Node.FuncCall({ ..Node.func_call_of($n), agg_within_group: Bool.False })
	$n = Node.FuncCall({ ..Node.func_call_of($n), agg_star: Bool.False })
	$n = Node.FuncCall({ ..Node.func_call_of($n), agg_distinct: Bool.False })
	$n = Node.FuncCall({ ..Node.func_call_of($n), func_variadic: Bool.False })
	$n = Node.FuncCall({ ..Node.func_call_of($n), funcformat: $funcformat })
	$n = Node.FuncCall({ ..Node.func_call_of($n), location: $location })
	$n
}

system_func_name : Node.Text -> List(Node)
system_func_name = |name_arg| {
