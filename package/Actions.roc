## CreateRoleStmt: CREATE ROLE RoleId opt_with OptRoleList
rule_147 : Rt.Ctx, List(Rt.Value), List(I64), I64 -> Try(Rt.Value, Scan.Problem)
rule_147 = |_ctx, v, _l, _loc| {
	var $a3 = Rt.text_at(v, 2)
	var $a5 = Rt.list_at(v, 4)
	var $result = Rt.node_at(v, 0)
	var $n = Node.CreateRoleStmt(Node.create_role_stmt_default)
	$n = Node.CreateRoleStmt({ ..Node.create_role_stmt_of($n), stmt_type: 0 })
	$n = Node.CreateRoleStmt({ ..Node.create_role_stmt_of($n), role: $a3 })
	$n = Node.CreateRoleStmt({ ..Node.create_role_stmt_of($n), options: $a5 })
	$result = $n
	Ok(Rt.of_node($result))
}

