	var $result = Rt.node_at(v, 0)
	var $n = Node.CreateTrigStmt(Node.create_trig_stmt_default)
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), replace: $a2 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), isconstraint: Bool.False })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), trigname: $a4 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), relation: $a8 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), funcname: $a14 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), args: $a16 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), row: $a10 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), timing: $a5 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), events: Node.integer_of(Rt.linitial($a6)).ival })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), columns: Rt.node_list(Rt.lsecond($a6)) })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), when_clause: $a11 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), transition_rels: $a9 })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), deferrable: Bool.False })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), initdeferred: Bool.False })
	$n = Node.CreateTrigStmt({ ..Node.create_trig_stmt_of($n), constrrel: Node.Null })
	$result = $n
